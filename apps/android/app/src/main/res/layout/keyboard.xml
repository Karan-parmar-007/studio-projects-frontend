<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0a192f"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Tap the mic. Tap again to insert."
        android:textColor="#64ffda"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button style="@style/Mic" android:tag="mic" android:text="Mic" />
        <Button style="@style/Key" android:layout_weight="3" android:tag="space" android:text="space" />
        <Button style="@style/Key" android:tag="back" android:text="⌫" />
        <Button style="@style/Key" android:tag="enter" android:text="↵" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button style="@style/Key" android:tag="q" android:text="q" />
        <Button style="@style/Key" android:tag="w" android:text="w" />
        <Button style="@style/Key" android:tag="e" android:text="e" />
        <Button style="@style/Key" android:tag="r" android:text="r" />
        <Button style="@style/Key" android:tag="t" android:text="t" />
        <Button style="@style/Key" android:tag="y" android:text="y" />
        <Button style="@style/Key" android:tag="u" android:text="u" />
        <Button style="@style/Key" android:tag="i" android:text="i" />
        <Button style="@style/Key" android:tag="o" android:text="o" />
        <Button style="@style/Key" android:tag="p" android:text="p" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button style="@style/Key" android:tag="a" android:text="a" />
        <Button style="@style/Key" android:tag="s" android:text="s" />
        <Button style="@style/Key" android:tag="d" android:text="d" />
        <Button style="@style/Key" android:tag="f" android:text="f" />
        <Button style="@style/Key" android:tag="g" android:text="g" />
        <Button style="@style/Key" android:tag="h" android:text="h" />
        <Button style="@style/Key" android:tag="j" android:text="j" />
        <Button style="@style/Key" android:tag="k" android:text="k" />
        <Button style="@style/Key" android:tag="l" android:text="l" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button style="@style/Key" android:tag="shift" android:text="⇧" />
        <Button style="@style/Key" android:tag="z" android:text="z" />
        <Button style="@style/Key" android:tag="x" android:text="x" />
        <Button style="@style/Key" android:tag="c" android:text="c" />
        <Button style="@style/Key" android:tag="v" android:text="v" />
        <Button style="@style/Key" android:tag="b" android:text="b" />
        <Button style="@style/Key" android:tag="n" android:text="n" />
        <Button style="@style/Key" android:tag="m" android:text="m" />
        <Button style="@style/Key" android:tag="," android:text="," />
        <Button style="@style/Key" android:tag="." android:text="." />
    </LinearLayout>
</LinearLayout>
